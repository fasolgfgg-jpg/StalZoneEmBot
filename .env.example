# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
# .env в git не попадает (см. .gitignore).

# --- Telegram Bot ---
# Токен, выданный @BotFather
TG_CLIENT_TOKEN=your_telegram_bot_token_here

# --- StalCraft API (https://eapi.stalcraft.net/) ---
CLIENT_SECRET=your_stalcraft_client_secret_here
CLIENT_ID=your_stalcraft_client_id_here

# --- Steam API (необязательно) ---
# Нужен только если Steam начнёт резать запросы без ключа
STEAM_API_KEY=
